# Service configuration. Copy this file to .env for local overrides.
TOYAPP_APP_NAME=Agentic Eval Toy App
TOYAPP_HOST=127.0.0.1
TOYAPP_PORT=8000
TOYAPP_LOG_LEVEL=INFO

# Generation provider. Normal browser/API use defaults to the live
# OpenAI-compatible provider. Use `deterministic` explicitly for offline work.
TOYAPP_GENERATION_PROVIDER=openai
TOYAPP_GENERATION_MODEL=gpt-5.6-luna
TOYAPP_GENERATION_MODEL_REVISION=provider-managed
TOYAPP_GENERATION_TEMPERATURE=0.0
TOYAPP_GENERATION_MAX_TOKENS=1024
TOYAPP_GENERATION_TIMEOUT_SECONDS=30

# OpenAI-compatible credentials shared with METIS. Platform AI supplies both
# values. OPENAI_BASE_URL must be the full compatible endpoint, usually ending
# in /v1. Replace these placeholders in `.env`; never commit real credentials.
OPENAI_API_KEY=your-platform-ai-api-key
OPENAI_BASE_URL=https://your-platform-ai-gateway/v1

# Langfuse tracing. Keep disabled for offline tests. When enabled, each app
# session UUID is also the Langfuse session ID used by METIS retrieval.
TOYAPP_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_BASE_URL=https://your-langfuse-host
TOYAPP_LANGFUSE_ENVIRONMENT=development
TOYAPP_LANGFUSE_FLUSH_ON_TURN=true

# Semantic retrieval. The model revision is an immutable Hugging Face commit.
TOYAPP_EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
TOYAPP_EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
TOYAPP_EMBEDDING_DEVICE=cpu
TOYAPP_RETRIEVAL_TOP_K=3
TOYAPP_RETRIEVAL_MIN_SIMILARITY=0.25
# TOYAPP_EMBEDDING_CACHE_DIR=/absolute/path/to/model-cache

# Per-turn agent limits.
TOYAPP_AGENT_MAX_MODEL_CALLS=4
TOYAPP_AGENT_MAX_SEARCHES=2

# Process-local conversation memory. Complete user/assistant turns are retained.
TOYAPP_SESSION_MAX_TURNS=10

# Service configuration. Copy this file to .env for local overrides.
TOYAPP_APP_NAME=Agentic Eval Toy App
TOYAPP_HOST=127.0.0.1
TOYAPP_PORT=8000
TOYAPP_LOG_LEVEL=INFO

# Top-level agent runtime. The coordinator handles policy and uploaded-report
# tasks by default; use `rag` for the standalone policy agent and trace export.
TOYAPP_AGENT_MODE=coordinator
TOYAPP_COORDINATOR_MAX_MODEL_CALLS=2
# Analysis has its own output allowance; it sends the full selected report once.
TOYAPP_ANALYSIS_MAX_OUTPUT_TOKENS=16384

# Generation provider. Normal browser/API use defaults to the live
# OpenAI-compatible provider. Use `deterministic` explicitly for offline work.
TOYAPP_GENERATION_PROVIDER=openai
TOYAPP_GENERATION_MODEL=gpt-5.6-luna
TOYAPP_GENERATION_MODEL_REVISION=provider-managed
TOYAPP_GENERATION_TEMPERATURE=0.0
TOYAPP_GENERATION_MAX_TOKENS=1024
TOYAPP_GENERATION_TIMEOUT_SECONDS=90

# OpenAI-compatible credentials shared with METIS. Platform AI supplies both
# values. OPENAI_BASE_URL must be the full compatible endpoint, usually ending
# in /v1. Replace these placeholders in `.env`; never commit real credentials.
OPENAI_API_KEY=your-platform-ai-api-key
OPENAI_BASE_URL=https://your-platform-ai-gateway/v1

# Langfuse export is available for coordinator and standalone RAG turns.
# Offline tests disable or isolate tracing. Each app session UUID is also the
# Langfuse session ID used by METIS retrieval.
TOYAPP_LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
# Use the service base URL, including any reverse-proxy prefix (for example,
# https://gcapdev.aip.gov.sg/langfuse); do not append /api/public/otel/v1/traces.
LANGFUSE_BASE_URL=https://your-langfuse-host
TOYAPP_LANGFUSE_ENVIRONMENT=development
# Keep true for evaluation runs, which read traces right after a turn. Set false
# only for load tests: no per-turn flush, the SDK exports in the background, and
# one final flush runs at shutdown. A crash or kill can lose unexported traces.
TOYAPP_LANGFUSE_FLUSH_ON_TURN=true
# Opt in only for synthetic reports used in grounding evaluations. This exports
# complete extracted report text (up to the upload limit) to Langfuse.
TOYAPP_LANGFUSE_INCLUDE_REPORT_TEXT=false

# Semantic retrieval. The model revision is an immutable Hugging Face commit.
TOYAPP_EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
TOYAPP_EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
TOYAPP_EMBEDDING_DEVICE=cpu
# Local development may download a missing pinned model. Docker overrides this
# to true because the model is already included in the image.
TOYAPP_EMBEDDING_LOCAL_FILES_ONLY=false
TOYAPP_RETRIEVAL_TOP_K=3
TOYAPP_RETRIEVAL_MIN_SIMILARITY=0.25
# TOYAPP_EMBEDDING_CACHE_DIR=/absolute/path/to/model-cache

# Backpressure, sized for a key with 200 requests/min and 2M tokens/min used
# only by this app. Over the turn cap, messages get 503 `server_busy`.
# Rate  = floor(0.9 x key RPM); concurrency ~= 1.5 x calls/second x mean call
# latency in seconds; turn cap ~= (rate / calls per turn) x acceptable wait in
# minutes. Each must be at least 1. See docs/rate-limits.md.
TOYAPP_MAX_PENDING_TURNS=128
TOYAPP_LLM_MAX_REQUESTS_PER_MINUTE=180
TOYAPP_LLM_MAX_CONCURRENT_CALLS=16

# Per-turn agent limits.
TOYAPP_AGENT_MAX_MODEL_CALLS=4
TOYAPP_AGENT_MAX_SEARCHES=2

# Conversation and report storage. Local `make run` defaults to process-local
# storage. Select Redis to persist conversation history, original uploads,
# report metadata, and extracted text across app restarts. Configure Redis
# persistence, access controls, and backups appropriate to the environment.
TOYAPP_SESSION_MAX_TURNS=10
TOYAPP_SESSION_STORE_BACKEND=memory
# TOYAPP_REDIS_URL=rediss://user:password@redis.example:6380/0
TOYAPP_REDIS_KEY_PREFIX=agentic-eval-toyapp
TOYAPP_REDIS_SOCKET_TIMEOUT_SECONDS=5
# The distributed lock covers one complete agent turn across app workers.
TOYAPP_REDIS_LOCK_TIMEOUT_SECONDS=1800
TOYAPP_REDIS_LOCK_BLOCKING_TIMEOUT_SECONDS=10

# Report upload limits for both storage backends. Uploading a file does not send
# a message or invoke an agent. Text-based PDFs are supported; OCR is not.
TOYAPP_UPLOAD_MAX_BYTES=5242880
TOYAPP_UPLOAD_MAX_PDF_PAGES=50
TOYAPP_UPLOAD_MAX_EXTRACTED_CHARACTERS=100000
TOYAPP_UPLOAD_MAX_FILES_PER_MESSAGE=1
TOYAPP_UPLOAD_MAX_REPORTS_PER_SESSION=10

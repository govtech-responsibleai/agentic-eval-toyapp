# Load local settings and secrets (.env is gitignored) into the shell, so tools that
# read os.environ directly, such as the Langfuse SDK, see them as well as the app.
dotenv_if_exists .env

# Put the uv-managed virtualenv on PATH so `pytest`, `ruff`, `pyright` and
# `uvicorn` work without the `uv run` prefix.
export VIRTUAL_ENV="$PWD/.venv"
PATH_add .venv/bin

# Offline-friendly default: run without live model or Langfuse calls unless
# .env says otherwise. Delete these two lines to use the live provider.
export TOYAPP_GENERATION_PROVIDER="${TOYAPP_GENERATION_PROVIDER:-deterministic}"
export TOYAPP_LANGFUSE_ENABLED="${TOYAPP_LANGFUSE_ENABLED:-false}"
